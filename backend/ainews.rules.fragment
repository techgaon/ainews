    // AI_NEWS_BEGIN — isolated from all other applications.
    function ainAdmin() {
      return request.auth != null
        && request.auth.token.email == 'surajbhanpandey853@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function ainVisit() {
      return request.resource.data.keys().hasOnly(['day','device','at'])
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.device is string
        && request.resource.data.device.matches('^[a-f0-9]{64}$')
        && request.resource.data.at == request.time;
    }
    match /ainConfig/{id} {
      allow get: if id == 'publishing';
      allow list: if ainAdmin();
      allow create, update: if id == 'publishing' && ainAdmin()
        && request.resource.data.keys().hasOnly(['paused','resumeAt','updatedAt'])
        && request.resource.data.paused is bool
        && (request.resource.data.resumeAt == null || request.resource.data.resumeAt is timestamp)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /ainVisits/{id} {
      allow create: if id.matches('^[a-f0-9-]{36}$') && ainVisit();
      allow read: if ainAdmin();
      allow update, delete: if false;
    }
    match /ainDevices/{id} {
      allow create: if id == request.resource.data.device && ainVisit();
      allow read: if ainAdmin();
      allow update, delete: if false;
    }
    match /ainDailyDevices/{id} {
      allow create: if id == request.resource.data.day + '_' + request.resource.data.device && ainVisit();
      allow read: if ainAdmin();
      allow update, delete: if false;
    }
    match /ainUsers/{uid} {
      allow get: if ainAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if ainAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['name','email','photo','createdAt','lastLogin'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 2048
        && request.resource.data.createdAt == request.time && request.resource.data.lastLogin == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photo','lastLogin'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 2048
        && request.resource.data.lastLogin == request.time;
      allow delete: if false;
    }
    // AI_NEWS_END
